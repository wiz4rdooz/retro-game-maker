{
  "name": "retro-game-maker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/engine && tsc -p packages/runtime && tsc -p packages/editor",
    "test": "vitest run",
    "bench": "vitest bench --run --reporter=verbose",
    "test:e2e": "playwright test",
    "build": "npm run build -w @rgm/editor",
    "dev": "npm run dev -w @rgm/editor"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
